@model Glitch.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Glitch</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #0f0f1a;
                font-family: 'Segoe UI', sans-serif;
                color: #fff;
            }

            .auth-card {
                background: #1a1a2e;
                border: 1px solid #2a2a4a;
                border-radius: 16px;
                padding: 40px;
                width: 100%;
                max-width: 420px;
                box-shadow: 0 0 40px rgba(99, 102, 241, 0.15);
            }

            .logo {
                text-align: center;
                margin-bottom: 28px;
            }

                .logo h1 {
                    font-size: 28px;
                    font-weight: 800;
                    color: #6366f1;
                    letter-spacing: 1px;
                }

                .logo p {
                    font-size: 13px;
                    color: #888;
                    margin-top: 4px;
                }

            .form-group {
                margin-bottom: 18px;
            }

                .form-group label {
                    display: block;
                    font-size: 13px;
                    color: #aaa;
                    margin-bottom: 6px;
                }

                .form-group input {
                    width: 100%;
                    padding: 11px 14px;
                    background: #0f0f1a;
                    border: 1px solid #2a2a4a;
                    border-radius: 8px;
                    color: #fff;
                    font-size: 14px;
                    outline: none;
                    transition: border 0.2s;
                }

                    .form-group input:focus {
                        border-color: #6366f1;
                    }

            .field-error {
                color: #f87171;
                font-size: 12px;
                margin-top: 5px;
            }

            .btn-primary {
                width: 100%;
                padding: 12px;
                background: #6366f1;
                color: #fff;
                border: none;
                border-radius: 8px;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                margin-top: 6px;
                transition: background 0.2s;
            }

                .btn-primary:hover {
                    background: #4f46e5;
                }

            .auth-footer {
                text-align: center;
                margin-top: 20px;
                font-size: 13px;
                color: #888;
            }

                .auth-footer a {
                    color: #6366f1;
                    text-decoration: none;
                    font-weight: 600;
                }

                    .auth-footer a:hover {
                        text-decoration: underline;
                    }

            .alert-danger {
                background: #450a0a;
                border: 1px solid #dc2626;
                color: #fca5a5;
                padding: 10px 14px;
                border-radius: 8px;
                font-size: 13px;
                margin-bottom: 16px;
            }
            .validation-summary-valid { display: none; }
            .validation-summary-errors ul { list-style: none; padding-left: 0; }
    </style>
</head>
<body>
    <div class="auth-card">

        <!-- Logo -->
        <div class="logo">
            <h1>🎮The<span>Glitch</span></h1>
            <p>Reset your password</p>
        </div>

        <!-- General errors like wrong email/username combination -->
        <div asp-validation-summary="ModelOnly" class="alert-danger"></div>

        <!-- Forgot Password form -->
        <form asp-action="ForgotPassword" asp-controller="Account" method="post">

            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <!-- Username -->
            <div class="form-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" placeholder="Enter your username for verification" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <!-- New Password -->
            <div class="form-group">
                <label asp-for="NewPassword">New Password</label>
                <input asp-for="NewPassword" type="password" placeholder="Enter new password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <!-- Confirm New Password -->
            <div class="form-group">
                <label asp-for="ConfirmNewPassword">Confirm New Password</label>
                <input asp-for="ConfirmNewPassword" type="password" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
            </div>

            <!-- Submit button -->
            <button type="submit" class="btn-primary">Reset Password</button>

        </form>

        <!-- Link to login page -->
        <div class="auth-footer">
            Remembered your password?
            <a asp-action="Login" asp-controller="Account">Back to Login</a>
        </div>

    </div>
</body>
</html>
